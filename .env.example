# Copy to .env.local and fill in. Never commit values.
APP_ENV=
DATABASE_URL=
E2E_TEST_PASSWORD=
# true shows Employees/payroll and GST/finance screens; default: off when APP_ENV=production, on otherwise
NEXT_PUBLIC_FEATURE_FINANCE_PAYROLL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# dev only: true shows the demo role switcher (ignored when APP_ENV=production); leave unset otherwise
NEXT_PUBLIC_DEV_ROLE_SWITCHER=
